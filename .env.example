# Copy to .env.development or .env.production and fill in values

NODE_ENV=development|production
DB_DRIVER=sqlite|postgres

# SQLite (dev only)
DATABASE_URL=./dev.db

# PostgreSQL (prod)
# DATABASE_URL=postgresql://user:password@host:5432/character_printer

NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
# Staging URL — used by activate-staging.sh on copied VMs
NEXTAUTH_URL_STAGING=https://staging.yourdomain.com

# Storage driver
# Use local for native development without AIStor.
# Use s3 for Docker/production AIStor or another S3-compatible service.
STORAGE_DRIVER=local|s3

# Docker / PostgreSQL defaults
APP_PORT=3000
POSTGRES_DB=character_printer
POSTGRES_USER=character_printer
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=character-images
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=character-printer
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true

# AIStor host ports
AISTOR_API_PORT=9000
AISTOR_CONSOLE_PORT=9001

# Email — toggle MAIL_PROVIDER to switch between providers
# Values: resend (production) | mailtrap (sandbox) | disabled (stress testing)
MAIL_PROVIDER=mailtrap
MAIL_FROM_ADDRESS=noreply@character-printer.app
MAIL_FROM_NAME=Print 2 Play

# Mailtrap SMTP sandbox (MAIL_PROVIDER=mailtrap)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=

# Resend (MAIL_PROVIDER=resend)
RESEND_API_KEY=

# Cloudflare Tunnel (prod)
CLOUDFLARE_TUNNEL_TOKEN=
# Cloudflare Tunnel (staging) — offline when not in use, activated by activate-staging.sh
CLOUDFLARE_TUNNEL_TOKEN_STAGING=

# Disable Next.js data cache — activate-staging.sh sets to 1 for stress testing
# Empty = cache active (production default)
NEXT_PRIVATE_SKIP_FETCH_CACHE=