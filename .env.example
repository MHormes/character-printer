# Copy to .env.development or .env.production and fill in values

NODE_ENV=development|production
DB_DRIVER=sqlite|postgres

# SQLite (dev only)
DATABASE_URL=./dev.db

# PostgreSQL (prod)
# DATABASE_URL=postgresql://user:password@host:5432/character_printer

NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Docker / PostgreSQL defaults
APP_PORT=3000
POSTGRES_DB=character_printer
POSTGRES_USER=character_printer
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=character-images
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=character-printer
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true

# MinIO host ports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
