{
  "name": "character-printer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "dotenv -e .env.local -- next dev",
    "build": "dotenv -e .env.production -- next build",
    "build:container": "next build",
    "start": "dotenv -e .env.production -- next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:generate:pg": "dotenv -e .env.development -- drizzle-kit generate",
    "db:migrate:dev": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e .env.production -- drizzle-kit migrate",
    "db:studio:dev": "dotenv -e .env.local -- drizzle-kit studio",
    "db:studio:prod": "dotenv -e .env.production -- drizzle-kit studio",
    "db:seed": "dotenv -e .env.local -- tsx lib/db/seed-srd-sqlite.ts && dotenv -e .env.local -- tsx lib/db/seed-srd-2024.ts && dotenv -e .env.local -- tsx lib/db/import-csv.ts",
    "db:export": "dotenv -e .env.local -- tsx lib/db/export-csv.ts",
    "db:import": "dotenv -e .env.local -- tsx lib/db/import-csv.ts",
    "db:export:prod": "dotenv -e .env.production -- tsx lib/db/export-csv.ts",
    "db:import:prod": "dotenv -e .env.production -- tsx lib/db/import-csv.ts",
    "docker:dev": "sh scripts/setup.sh development",
    "docker:prod": "sh scripts/setup.sh production"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1077.0",
    "@aws-sdk/s3-request-presigner": "^3.1077.0",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "immer": "^11.1.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.22.0",
    "next": "16.2.4",
    "next-auth": "^4.24.14",
    "nodemailer": "^9.0.3",
    "otpauth": "^9.5.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.0.2",
    "resend": "^6.16.0",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
